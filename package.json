{
  "private": true,
  "type": "module",
  "name": "buckeye-gpt",
  "description": "Buckeye GPT is an independent AI chatbot making advanced language models freely accessible to Ohio State students",
  "version": "0.17.0",
  "keywords": [
    "nextjs",
    "stack-auth",
    "typescript",
    "daisyui",
    "langchain",
    "openai"
  ],
  "homepage": "https://buckeye.chat",
  "license": "AGPL-3.0-only",
  "author": {
    "name": "Keming He",
    "email": "keminghe.career@gmail.com",
    "url": "https://www.linkedin.com/in/keminghe/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KemingHe/buckeye-gpt.git"
  },
  "bugs": {
    "url": "https://github.com/KemingHe/buckeye-gpt/issues/new",
    "email": "keminghe.career@gmail.com"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "biome ci .",
    "lint:fix": "biome check --write .",
    "build": "next build",
    "test:unit": "vitest",
    "test:unit:coverage": "vitest --coverage.enabled",
    "test:unit:update-snapshots": "vitest --update",
    "test:e2e:install": "playwright install --with-deps chromium webkit firefox",
    "test:e2e": "playwright test",
    "test:e2e:update-snapshots": "playwright test --update-snapshots",
    "test": "pnpm test:unit:coverage && pnpm test:e2e",
    "verify": "pnpm check:changesets && pnpm lint && pnpm test && pnpm scan:secrets",
    "verify:lite": "pnpm check:changesets && pnpm lint && pnpm test:unit:coverage",
    "dev": "next dev --turbopack",
    "check:changesets": "changeset status",
    "check:favicon": "realfavicon check -s cli 3000",
    "scan:secrets": "ggshield secret scan repo .",
    "start": "next start"
  },
  "dependencies": {
    "@agentic/ai-sdk": "^7.6.9",
    "@agentic/google-custom-search": "^7.6.9",
    "@ai-sdk/google": "^1.2.22",
    "@ai-sdk/react": "^1.2.12",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^3.10.0",
    "@keminghe/osu": "^4.0.1",
    "@next/third-parties": "^15.5.7",
    "@stackframe/stack": "^2.8.54",
    "ai": "^4.3.19",
    "canvas-confetti": "^1.9.4",
    "next": "^15.5.7",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.68.0",
    "react-markdown": "^9.1.0",
    "react-modal": "^3.16.3",
    "react-toastify": "^11.0.5",
    "react-tooltip": "^5.30.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/dotenv-safe": "^8.1.6",
    "@types/node": "^22.19.1",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@types/react-modal": "^3.16.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.22",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "daisyui": "^4.12.24",
    "dotenv-safe": "^9.1.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.6",
    "realfavicon": "^0.4.18",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.24.0+sha512.01ff8ae71b4419903b65c60fb2dc9d34cf8bb6e06d03bde112ef38f7a34d6904c424ba66bea5cdcf12890230bf39f9580473140ed9c946fef328b6e5238a345a"
}
